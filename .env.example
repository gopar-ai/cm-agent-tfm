# Plantilla de configuración. Copiar como .env.local y rellenar.
#
#   cp .env.example .env.local
#
# Fuera de producción no hace falta nada de esto: la aplicación rellena usuario
# demo / contraseña demo1234 y un secreto de firma efímero, y el agente responde
# con su guion de demostración. En producción, los tres primeros valores son
# obligatorios y la aplicación no arranca sin ellos.
#
# Nunca escribir valores reales en este archivo: es el que se publica.


# --- Agente ------------------------------------------------------------------

# Clave de Anthropic. Sin ella, el agente responde con el guion de demostración.
ANTHROPIC_API_KEY=

# true fuerza el guion de demostración aunque haya clave (es lo que usa la demo
# publicada y la integración continua).
DEMO_MODE=


# --- Acceso ------------------------------------------------------------------

APP_USERNAME=

# Contraseña en hash. Se genera con:  npm run hash-password -- "tu contraseña"
APP_PASSWORD_HASH=

# Alternativa en claro: se acepta y se convierte en hash al arrancar, pero en
# producción queda marcada como aviso. Preferible usar APP_PASSWORD_HASH.
APP_PASSWORD=

# Firma de la sesión. Mínimo 32 caracteres aleatorios:
#   openssl rand -hex 32
JWT_SECRET=

# Protege el refresco programado del feed. Sin esta variable, esa ruta responde
# 503 en vez de quedar abierta.
CRON_SECRET=


# --- Límites de uso y de gasto -----------------------------------------------

# Llamadas al modelo por día. Al agotarse, el agente sigue atendiendo con el
# guion de demostración. Por defecto 120.
DAILY_MODEL_CALL_BUDGET=

# Intentos de acceso por IP y tamaño de la ventana en segundos. Por defecto 8 y 300.
LOGIN_MAX_ATTEMPTS=
LOGIN_WINDOW_SECONDS=

# Peticiones de chat por minuto y sesión. Por defecto 10.
CHAT_MAX_PER_MINUTE=


# --- Marca -------------------------------------------------------------------
# Sin configurar, se usa una marca ficticia de ejemplo (Trazo Seguro).
# Estas variables se incrustan al construir: cambiarlas exige un despliegue nuevo.

NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_DESCRIPTION=
NEXT_PUBLIC_BRAND_CORE_SERVICE=
NEXT_PUBLIC_BRAND_WEBSITE=
NEXT_PUBLIC_BRAND_AUDIENCE=
NEXT_PUBLIC_BRAND_SECTOR=

# Texto con las credenciales de prueba que se muestra bajo el formulario de
# acceso. Solo para una demo pública; dejar vacío en una instalación real.
DEMO_HINT=


# --- Fuentes del sector ------------------------------------------------------
# Separadas por coma. Los feeds admiten "url|nombre del medio".

NEWS_RSS_FEEDS=
NEWS_SEARCH_DOMAINS=
NEWS_SEARCH_QUERIES=

# Carpeta de la caché del feed. Por defecto ./data
NEWS_CACHE_DIR=
