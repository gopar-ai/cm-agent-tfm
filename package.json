{
  "name": "cm-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Agente de community manager con IA para LinkedIn: flujo conversacional de 4 fases, feed de noticias, calendario de contenido y memoria de preferencias editoriales.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test:cov",
    "start:e2e": "next build && next start",
    "hash-password": "node scripts/hash-password.mjs",
    "slides": "node scripts/slides.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
